{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "methods": ["OPTIONS"],
      "dest": "/api/preflight.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    }
  ]
}
